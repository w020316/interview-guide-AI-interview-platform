<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>interview-guide</artifactId>
    <version>1.74.1</version>
    <name>interview-guide</name>
    <description>AI 智能面试辅助平台</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <springdoc.version>2.6.0</springdoc.version>
        <!-- ══ 安全补丁批次 1（2026-10-18，见 docs/quality-loop-2026-10-18/04-依赖审计.md）══
             依据：OSV/GHSA 逐版本比对 182 个构件，28 个命中 107 条漏洞。
             本批只做**同一大版本线内的补丁升级**，不迁移框架 —— 目的是把
             「留在 3.3.x 上也能修掉」的那部分先消掉，与「必须升 4.1」的结构性问题分开。

             为什么是覆盖属性而不是升 parent：spring-boot-starter-parent 3.3.13 已把
             tomcat/postgresql/logback/netty 的版本写死在 spring-boot-dependencies 里，
             在 <properties> 里声明同名属性即可覆盖，改动面最小。

             ⚠️ 全部为补丁线（10.1.x / 42.7.x / 1.5.x / 4.1.x），务必保持大版本不变，
             否则会连带改变 Jackson/编译器/API 语义。 -->
        <tomcat.version>10.1.61</tomcat.version>
        <postgresql.version>42.7.14</postgresql.version>
        <logback.version>1.5.38</logback.version>
        <netty.version>4.1.139.Final</netty.version>
        <!-- G8（2026-10-18）：实网探针默认不参与回归。
             背景：全量 1277 用例耗时 5 分 07 秒，其中 7 个 Probe 类合计 194 秒（63%），
             且全部依赖外网 —— 断网/被墙/上游改版都会让 CI 假红，与本次改动无关。
             这些类已打 @Tag("probe")；要单独跑它们时用 -Dsurefire.excludedGroups= 清空排除。 -->
        <surefire.excludedGroups>probe</surefire.excludedGroups>
    </properties>

    <!-- Spring AI BOM 统一管理版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI 1.0 GA - OpenAI 协议 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring AI pgvector 向量库（生产环境通过 autoconfigure exclude 禁用，避免 Metaspace OOM） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- PDFBox 轻量 PDF 解析（替代 Tika，大幅减少 Metaspace 占用） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>

        <!-- jsoup HTML 解析（从 HTML 简历中提取纯文本） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- PostgreSQL 驱动 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- H2 内存数据库（本地联调 profile=local 时使用） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Security（JWT 鉴权） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JJWT - JWT 签发与验证 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Bucket4j 限流（纯内存，不依赖 Redis 扩展包） -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- SpringDoc OpenAPI 3 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Prometheus 指标采集 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>interview-guide</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- P2-10（2026-09-20）：落到纯 ASCII 临时路径，规避中文项目路径下
                                 surefire 经 cmd.exe 分叉时代码页损坏 -javaagent 目标文件，
                                 导致 jacoco.exec 落进乱码目录、文件名被截断为 jacoco.exe、
                                 backend/target/jacoco.exec 缺失而 report/check 被静默跳过。 -->
                            <destFile>${java.io.tmpdir}/interview-guide-jacoco.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/interview-guide-jacoco.exec</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/interview-guide-jacoco.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} 为延迟绑定：jacoco:prepare-agent 会把 -javaagent 写进
                         名为 argLine 的属性，surefire 在分叉 JVM 时才展开，二者缺一不可。
                         同时为测试 JVM 显式设内存上限：JaCoCo 真正生效后会对全部类做插桩，
                         fork JVM 默认无上限，实测在本机原生内存紧张时先后出现两种崩溃：
                         ① malloc failed ... Chunk::new（JIT 编译器原生内存）
                         ② mmap failed to map ... for G1 virtual space（G1 启动期映射失败）
                         故改用 SerialGC（与生产 512MB 容器同款，虚拟空间占用小）并设上限。
                         此配置只作用于测试分叉 JVM，不影响生产容器内存参数。 -->
                    <argLine>@{argLine} -Xmx1024m -XX:MaxMetaspaceSize=512m -XX:ReservedCodeCacheSize=192m -XX:+UseSerialGC</argLine>
                    <!-- G8：默认排除 @Tag("probe") 的实网探针，见 <properties> 中的说明。
                         值走属性而非写死，便于 -Dsurefire.excludedGroups= 临时放开。 -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
