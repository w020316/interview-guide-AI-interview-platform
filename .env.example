# ─────────────────────────── 数据库 (Supabase) ───────────────────────────
# 格式: jdbc:postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/interview
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password

# ─────────────────────────── Redis (Upstash) ───────────────────────────
# 格式: rediss://default:[PASSWORD]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_SSL=false

# ─────────────────────────── AI 模型 ───────────────────────────
# v1.22.0 起聊天模型为降级链：B.AI GLM-5.3-Flash（主）→ B.AI Qwen3.8-Flash（次）→ Agnes AI（兜底）
# 主/次模型：B.AI（0 Credits 免费额度，OpenAI 兼容协议）
AI_BAI_API_KEY=your_bai_api_key
AI_BAI_BASE_URL=https://api.b.ai
AI_BAI_CHAT_MODEL=glm-5.3-flash
AI_BAI_CHAT_MODEL_SECONDARY=qwen3.8-flash

# 兜底模型 + 知识库 Embedding：Agnes AI（国内访问较好）
AI_API_KEY=your_agnes_api_key
AI_BASE_URL=https://apihub.agnes-ai.com
AI_CHAT_MODEL=agnes-2.0-flash
AI_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────── 招聘信息智能体（可选）───────────────────
# 内置秋招精选数据源始终启用；第三方平台需配置招聘数据服务（OpenAI 聚合类 API）后启用
# JOB_ZHAOPIN_ENDPOINT=
# JOB_ZHAOPIN_API_KEY=
# JOB_51JOB_ENDPOINT=
# JOB_51JOB_API_KEY=
# JOB_BOSS_ENDPOINT=
# JOB_BOSS_API_KEY=
# 定时刷新间隔（毫秒，默认 6 小时）
# JOB_REFRESH_DELAY=21600000

# ─────────────────────────── JWT ───────────────────────────
# 生产环境必须修改为随机32位以上字符串
JWT_SECRET=change-this-in-production-must-be-32-chars-min!!
JWT_EXPIRATION_MS=86400000

# ─────────────────────────── Supabase Storage ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# 在 Supabase Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_BUCKET=resumes

# ─────────────────────────── 前端 (Vercel) ───────────────────────────
VITE_API_BASE_URL=https://your-backend.onrender.com
